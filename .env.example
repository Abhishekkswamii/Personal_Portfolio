# =============================================================================
# Portfolio — environment
#
# Locally: copy to .env.local.
#
# The site is a static export built entirely from src/lib/content/seed.ts —
# there is no database and nothing here is required. This file only
# documents the one variable that changes output.
# =============================================================================

# -- Site ---------------------------------------------------------------------
# Used for canonical URLs and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://abhishekswami.work.gd

# Google Form embed URL — open your form, Send → < >, copy the src.
# Leave blank and "Let's talk" opens an email instead.
CONTACT_FORM_URL=
