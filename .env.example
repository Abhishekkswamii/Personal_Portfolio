# =============================================================================
# Portfolio — environment
#
# Locally: copy to .env.local.
# On Render: set these in the Dashboard → your service → Environment. Never
# commit real values — this file only documents the variable names.
#
# Everything is OPTIONAL. With none of it set, the site builds and runs on the
# content bundled in src/lib/content/seed.ts — it is deployable before the
# database exists. REDIS_URL and AUTH_SECRET together turn on the admin.
# =============================================================================

# -- Database (Redis) ----------------------------------------------------------
# A Redis Cloud connection string (or any Redis 6.2+ instance), e.g.:
#   rediss://default:PASSWORD@host.redns.redis-cloud.com:12345
# Get this from Render → Environment, never from source, a screenshot, or a
# chat log — treat it exactly like a database password, because it is one.
REDIS_URL=

# -- Auth ---------------------------------------------------------------------
# Signs the admin session cookie. At least 32 characters; anything shorter is
# refused. Generate one with:  openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=

# -- Media --------------------------------------------------------------------
# Absolute path to a writable directory that survives deploys and restarts.
#
# This matters on Render specifically: its web services run on an ephemeral
# filesystem by default, so anything written into the app's own folder —
# public/ included — disappears on the next deploy. Point this at a mounted
# **persistent disk** instead (see render.yaml):
#
#   MEDIA_ROOT=/var/data/uploads
#
# Left unset, it defaults to ./public/uploads, which is fine for local
# development but WRONG in production.
MEDIA_ROOT=

# Largest accepted upload, in megabytes. Files are re-encoded to WebP on the
# way in, so the stored size is usually far smaller.
# Set both — the server enforces MAX_UPLOAD_MB, the admin UI displays the
# NEXT_PUBLIC_ copy. Keep them the same.
MAX_UPLOAD_MB=12
NEXT_PUBLIC_MAX_UPLOAD_MB=12

# -- Site ---------------------------------------------------------------------
# Used for canonical URLs and Open Graph. No trailing slash.
# Works with either the onrender.com URL or a verified custom domain.
NEXT_PUBLIC_SITE_URL=https://abhishekswami.work.gd

# Google Form embed URL — open your form, Send → < >, copy the src.
# Once Redis is running this is editable in Admin → Site settings, and the
# stored value wins. Leave blank and "Let's talk" opens an email instead.
CONTACT_FORM_URL=

# -- Tuning (optional) --------------------------------------------------------
# How long a public content read may take before falling back to seed content.
REDIS_TIMEOUT_MS=2000
